# Copy to .env and fill in. Never commit .env.

# --- Docker Compose (infra/docker-compose.yml) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
ERP_DOMAIN=chonryong.com            # www.<domain> redirects here; "localhost" for a local trial (Caddy issues a local cert)
ERP_ENV=prod
ERP_COOKIE_SECURE=true
BACKUP_KEEP_DAYS=14                  # daily database dumps kept in the backups volume
BACKUP_HOUR=01                       # UTC hour of the daily backup

# --- Local development without Docker (apps/api reads ERP_* variables) ---
# ERP_DATABASE_URL=postgresql+asyncpg://erp:erp@127.0.0.1:54329/erp
# ERP_COOKIE_SECURE=false
